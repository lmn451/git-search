{
  "name": "git-log-s",
  "displayName": "git-search",
  "description": "git log -S/G in your VS Code",
  "icon": "./assets/logo.png",
  "version": "0.3.7",
  "publisher": "lmn451",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/git-search"
  },
  "engines": {
    "vscode": "^1.86.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "git",
    "search",
    "find",
    "log",
    "git log",
    "git search"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-search.showPanel",
        "title": "Show Git Search Panel"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "pnpm -s lint",
    "prettier": "prettier -w src",
    "test": "node ./test/runTest.js",
    "test:ext": "node ./test/runTest.js",
    "test:unit": "mocha \"test/unit/**/*.test.js\"",
    "test:unit:watch": "mocha \"test/unit/**/*.test.js\" --watch --watch-files src test/unit",
    "coverage": "c8 -r text -r html pnpm run test:unit",
    "test:all": "pnpm run test:unit && pnpm run test:ext"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "~18.19.14",
    "@types/vscode": "^1.86.0",
    "@vscode/test-electron": "^2.3.9",
    "c8": "^10.1.3",
    "eslint": "^9.35.0",
    "glob": "^10.3.10",
    "globals": "^16.4.0",
    "mocha": "^10.2.0",
    "sinon": "^17.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2"
  },
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef"
}
