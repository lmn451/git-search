{
  "name": "git-log-s",
  "displayName": "git-search",
  "description": "git log -S/G in your VS Code",
  "icon": "./assets/logo.png",
  "version": "0.3.7",
  "publisher": "lmn451",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/git-search"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "git",
    "search",
    "find",
    "log",
    "git log",
    "git search"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-search.showPanel",
        "title": "Show Git Search Panel"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "prettier": "prettier -w src",
    "test": "node ./test/runE2ETests.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.0.10",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.30.1",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
